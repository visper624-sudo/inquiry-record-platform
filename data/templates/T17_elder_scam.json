{
  "template_id": "T17",
  "code": "elder_scam",
  "name": "养老诈骗类",
  "category": "养老诈骗",
  "is_general": false,
  "version": "1.0",
  "description": "骗子以销售特效保健品、养老项目、以房养老、养老服务卡为名，通过免费领鸡蛋、健康讲座、义诊、低价旅游等方式接近老年人，由所谓专家义诊、业务员上门嘘寒问暖，宣称投资养老床位、养老公寓可获高额返利。老年人付款购买产品或签订投资合同后，公司关门失联，钱款无法追回。",
  "feature_signals": ["保健品", "免费领鸡蛋", "健康讲座", "义诊", "养老项目", "以房养老", "养老床位", "高额返利", "专家讲课", "收藏品", "低价旅游", "养老公寓"],
  "weight_keywords": ["养老", "保健品", "投资", "返利"],
  "sections": [
    {
      "key": "opening",
      "title": "固定开头",
      "questions": [
        {"qid": "T17-S1-Q01", "text": "我们是本市公安机关反诈中心的民警，今天就你被骗一事向你询问，请配合并如实陈述，你清楚了吗？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S1-Q02", "text": "在询问之前告知你，如实提供情况是你的法定义务，隐瞒或者编造事实要承担相应法律责任，你是否听明白？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S1-Q03", "text": "你在接受询问过程中可以随时补充、更正自己的陈述，也有权核对笔录，你清楚了吗？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S1-Q04", "text": "为固定你的陈述，本次询问全程同步录音录像，录音录像随案保存，你对此有无异议？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S1-Q05", "text": "请说明你的姓名、身份证号码、户籍地址、现住址和退休前职业：", "flow": "personnel", "field": "victim_identity", "key_item": true}
      ]
    },
    {
      "key": "contact",
      "title": "接触引流",
      "questions": [
        {"qid": "T17-S2-Q01", "text": "你第一次接触对方是通过什么方式？是听讲座、接到电话还是业务员上门？", "flow": "communication", "field": "call_time", "key_item": false},
        {"qid": "T17-S2-Q02", "text": "对方给你打电话时显示的是什么号码？是不是固定电话或者陌生手机号？", "flow": "communication", "field": "call_number", "key_item": true},
        {"qid": "T17-S2-Q03", "text": "对方自称是哪家公司的专家、主任或者业务员？姓名和公司名称是什么？", "flow": "personnel", "field": "suspect_claim_identity", "key_item": true},
        {"qid": "T17-S2-Q04", "text": "一直和你对接的业务员是谁？他多久联系你一次、怎么称呼你？", "flow": "personnel", "field": "agent_person", "key_item": false},
        {"qid": "T17-S2-Q05", "text": "你是在什么活动上认识对方的？免费领鸡蛋、健康讲座还是低价旅游？", "flow": "personnel", "field": "acquaintance", "key_item": false},
        {"qid": "T17-S2-Q06", "text": "你本人的手机号码是多少？平时和对方联系用的是电话还是微信？", "flow": "personnel", "field": "victim_contact", "key_item": false}
      ]
    },
    {
      "key": "process",
      "title": "被骗经过",
      "questions": [
        {"qid": "T17-S3-Q01", "text": "对方让你下载什么养老平台软件或者小程序？名称和界面是什么？", "flow": "network", "field": "app_name", "key_item": true},
        {"qid": "T17-S3-Q02", "text": "对方发给你的养老项目介绍或者投资平台网址是什么？完整地址是什么？", "flow": "network", "field": "url_domain", "key_item": true},
        {"qid": "T17-S3-Q03", "text": "对方发过收款二维码让你扫码付款吗？二维码是谁发来的、扫了几次？", "flow": "network", "field": "qr_code", "key_item": true},
        {"qid": "T17-S3-Q04", "text": "对方把你拉进了哪个微信群或者讲座群？群名称和群主是谁？", "flow": "network", "field": "chat_account", "key_item": false},
        {"qid": "T17-S3-Q05", "text": "讲座或者义诊上专家讲了什么？有没有让你现场买产品或者交定金？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S3-Q06", "text": "对方承诺投资养老床位、养老公寓能返多少利？签了什么合同或协议？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S3-Q07", "text": "你付款时是现金、刷卡还是转账？对方有没有开具收据或者发票？", "flow": null, "field": null, "key_item": false}
      ]
    },
    {
      "key": "loss",
      "title": "资金损失",
      "questions": [
        {"qid": "T17-S4-Q01", "text": "你第一次交钱是什么时间？具体日期和时刻是什么？", "flow": "fund", "field": "transfer_time", "key_item": true},
        {"qid": "T17-S4-Q02", "text": "你一共交了多少钱？买保健品、投资养老项目分别是多少？", "flow": "fund", "field": "transfer_amount", "key_item": true},
        {"qid": "T17-S4-Q03", "text": "付款是通过现金、刷卡、微信还是手机银行转出的？", "flow": "fund", "field": "pay_channel", "key_item": false},
        {"qid": "T17-S4-Q04", "text": "钱是从哪张银行卡或者存折转出的？开户银行和卡号后四位是什么？", "flow": "fund", "field": "payer_card", "key_item": false},
        {"qid": "T17-S4-Q05", "text": "对方收款账户是哪家银行的？开户支行名称是什么？", "flow": "fund", "field": "counterparty_bank", "key_item": false},
        {"qid": "T17-S4-Q06", "text": "对方收款账户的卡号或者账号是多少？是公司账户还是个人账户？", "flow": "fund", "field": "counterparty_card", "key_item": true},
        {"qid": "T17-S4-Q07", "text": "收款账户的开户人姓名是什么？和对方自称的公司名称是否一致？", "flow": "fund", "field": "counterparty_name", "key_item": true},
        {"qid": "T17-S4-Q08", "text": "你最终确认的损失总额是多少？对方承诺的返利有没有到账过？", "flow": "fund", "field": "total_loss", "key_item": true}
      ]
    },
    {
      "key": "evidence",
      "title": "证据补充",
      "questions": [
        {"qid": "T17-S5-Q01", "text": "你和业务员的聊天记录、讲座宣传单和合同是否保存？能否提供？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S5-Q02", "text": "对方寄给你的保健品或者宣传资料是通过哪家快递寄的？单号是什么？", "flow": "delivery", "field": "express_no", "key_item": true},
        {"qid": "T17-S5-Q03", "text": "你的付款凭证、收据和银行流水是否已经保存？能否提供给我们？", "flow": null, "field": null, "key_item": false},
        {"qid": "T17-S5-Q04", "text": "你有没有和其他老人一起被骗？是否已经向公安机关报案？", "flow": null, "field": null, "key_item": false}
      ]
    }
  ]
}
