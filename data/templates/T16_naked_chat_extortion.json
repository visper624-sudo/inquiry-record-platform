        {"qid": "T16-S4-Q05", "text": "对方收款账户是哪家银行的？开户支行名称是什么？", "flow": "fund", "field": "counterparty_bank", "key_item": false},
        {"qid": "T16-S4-Q06", "text": "对方收款账户的卡号或者账号是多少？是否换过多个收款账户？", "flow": "fund", "field": "counterparty_card", "key_item": true},
        {"qid": "T16-S4-Q07", "text": "收款账户的开户人姓名是什么？对方是否说过这是公司或者他人账户？", "flow": "fund", "field": "counterparty_name", "key_item": true},
        {"qid": "T16-S4-Q08", "text": "你最终确认的损失总额是多少？转账之后对方是否删除了视频？", "flow": "fund", "field": "total_loss", "key_item": true}
