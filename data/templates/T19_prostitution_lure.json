  "sections": [
    {
      "key": "opening",
      "title": "固定开头",
      "questions": [
        {"qid": "T19-S1-Q01", "text": "我们是公安机关反诈中心的民警，现就你报称被骗的情况向你了解经过，请你如实回答，听清楚了吗？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S1-Q02", "text": "依照法律规定，你有如实陈述的义务，故意隐瞒事实或者作虚假陈述要承担法律责任，你是否明白？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S1-Q03", "text": "询问结束后笔录会交你核对，如记录与你的陈述不符，可以当面提出补充和更正，你清楚了吗？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S1-Q04", "text": "本次询问全程同步录音录像，录音录像资料仅用于办案并严格保密，你对此有无异议？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S1-Q05", "text": "请陈述你的姓名、身份证号码、户籍地址、现住址以及目前从事的职业：", "flow": "personnel", "field": "victim_identity", "key_item": true}
      ]
    },
    {
      "key": "contact",
      "title": "接触引流",
      "questions": [
        {"qid": "T19-S2-Q01", "text": "你是在哪个社交软件或者平台看到对方信息的？对方账号、昵称是什么？", "flow": "network", "field": "chat_account", "key_item": false},
        {"qid": "T19-S2-Q02", "text": "对方自称是什么人？说过自己的年龄、所在地和服务内容吗？", "flow": "personnel", "field": "suspect_claim_identity", "key_item": true},
        {"qid": "T19-S2-Q03", "text": "你第一次和对方联系是什么时间？对方多久回复你、怎么称呼你？", "flow": "communication", "field": "call_time", "key_item": false},
        {"qid": "T19-S2-Q04", "text": "对方有没有给你打电话或者发语音？使用的是什么号码？", "flow": "communication", "field": "call_number", "key_item": true},
        {"qid": "T19-S2-Q05", "text": "你本人的手机号码是多少？对方是否通过这个号码加你为好友？", "flow": "personnel", "field": "victim_contact", "key_item": false}
      ]
    },
    {
      "key": "process",
      "title": "被骗经过",
      "questions": [
        {"qid": "T19-S3-Q01", "text": "对方让你通过什么方式付款或者下载软件？是扫码、发链接还是转账？", "flow": "network", "field": "qr_code", "key_item": true},
        {"qid": "T19-S3-Q02", "text": "对方要求你下载什么软件或者APP做验证？名称和界面是什么？", "flow": "network", "field": "app_name", "key_item": true},
        {"qid": "T19-S3-Q03", "text": "对方发给你的平台网址或者付款页面是什么？完整域名是什么？", "flow": "network", "field": "url_domain", "key_item": true},
        {"qid": "T19-S3-Q04", "text": "对方一开始怎么谈价格？服务费、定金、车费分别是多少？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S3-Q05", "text": "付完第一笔钱后，对方又以什么理由让你继续付款？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S3-Q06", "text": "对方约定在什么地方见面？实际有没有人来，后来是怎么联系不上的？", "flow": null, "field": null, "key_item": false},
        {"qid": "T19-S3-Q07", "text": "你付款和操作软件用的是什么型号的手机？页面有没有提示充值失败？", "flow": "network", "field": "login_ip", "key_item": false}
      ]
    },
    {
      "key": "loss",
      "title": "资金损失",
      "questions": [
        {"qid": "T19-S4-Q01", "text": "你第一次付款是什么时间？具体日期和时刻是什么？", "flow": "fund", "field": "transfer_time", "key_item": true},
        {"qid": "T19-S4-Q02", "text": "你一共付了几笔、合计多少钱？最大的一笔是多少？", "flow": "fund", "field": "transfer_amount", "key_item": true},
        {"qid": "T19-S4-Q03", "text": "付款是通过微信、支付宝还是手机银行转账的？有没有扫码支付？", "flow": "fund", "field": "pay_channel", "key_item": false},
        {"qid": "T19-S4-Q04", "text": "付款用的是哪张银行卡或者哪个支付账户？卡号后四位是什么？", "flow": "fund", "field": "payer_card", "key_item": false},
        {"qid": "T19-S4-Q05", "text": "对方收款账户是哪家银行的？开户支行名称是什么？", "flow": "fund", "field": "counterparty_bank", "key_item": false},
        {"qid": "T19-S4-Q06", "text": "对方收款账户的卡号或者账号是多少？是否每次收款账户都不一样？", "flow": "fund", "field": "counterparty_card", "key_item": true},
        {"qid": "T19-S4-Q07", "text": "收款账户的开户人姓名是什么？和对方自称的身份是否相符？", "flow": "fund", "field": "counterparty_name", "key_item": true},
        {"qid": "T19-S4-Q08", "text": "你最终确认的损失总额是多少？对方有没有退还过任何费用？", "flow": "fund", "field": "total_loss", "key_item": true}
